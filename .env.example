# =================================
# SLOzy Environment Configuration
# =================================

# Server Configuration
PORT=8080
HOST=0.0.0.0
DATA_DIR=/opt/slozy/data
TEMPLATES_DIR=/opt/slozy/templates
STATIC_DIR=/opt/slozy/static
LOG_LEVEL=info

# Production Paths (update these for production deployment)
# DATA_DIR=/opt/slozy/data
# TEMPLATES_DIR=/opt/slozy/templates
# STATIC_DIR=/opt/slozy/static

# =================================
# Notification Configuration
# =================================

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=1234567890:ABCDEFGHIJKLMNOPQRSTUVWXYZ
TELEGRAM_CHAT_ID=-1001234567890

# Optional: Different chats for different severities
TELEGRAM_WARNING_CHAT_ID=-1001111111111
TELEGRAM_CRITICAL_CHAT_ID=-1002222222222

# SMTP Configuration (for email alerts)
SMTP_HOST=smtp.example.com:587
SMTP_USERNAME=noreply@example.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=SLO Alerts <noreply@example.com>
SMTP_TLS=true

# Slack Configuration
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# PagerDuty Configuration
PAGERDUTY_INTEGRATION_KEY=your-pagerduty-integration-key

# =================================
# Monitoring Configuration
# =================================

# Grafana Configuration
GRAFANA_URL=https://grafana.example.com
GRAFANA_API_KEY=your-grafana-api-key
GRAFANA_FOLDER=SLO Dashboards

# Prometheus Configuration
PROMETHEUS_URL=https://prometheus.example.com
PROMETHEUS_API_KEY=your-prometheus-api-key

# AlertManager Configuration
ALERTMANAGER_URL=https://alertmanager.example.com

# =================================
# Security Configuration
# =================================

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,https://slozy.example.com

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_SECOND=10
RATE_LIMIT_BURST=20

# API Security
API_KEY_SECRET=your-32-byte-secret-key-here
JWT_SECRET=your-jwt-secret-key-here

# =================================
# Development Configuration
# =================================

# Development Mode (enables debug endpoints, hot reload, etc)
DEV_MODE=false

# Database (if using persistent storage instead of files)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=slozy
# DB_PASSWORD=your-db-password
# DB_NAME=slozy

# Redis (for caching and sessions)
# REDIS_HOST=localhost:6379
# REDIS_PASSWORD=your-redis-password